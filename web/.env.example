# Base URL of the Python API (server/app.py). Leave empty to use the same origin:
# the Vite dev server proxies /api to SR_API_PROXY, and server/app.py serves the built app itself.
VITE_API_URL=
# Where the dev server forwards /api requests.
SR_API_PROXY=http://127.0.0.1:8000
# Start in "live" (real backend) or "demo" (labelled sample data) mode. Users can switch in Settings.
VITE_DEFAULT_MODE=live
